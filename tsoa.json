{
  "entryFile": "src/main.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": [
    "./src/**/*.controller.ts"
  ],
  "spec": {
    "outputDirectory": "src/generated",
    "specVersion": 3
  },
  "routes": {
    "routesDir": "src/generated",
    "middleware": "express",
    "iocModule": "src/ioc"
  }
}