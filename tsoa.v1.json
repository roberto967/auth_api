{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": [
    "./src/modules/v1/**/*.controller.ts"
  ],
  "spec": {
    "basePath": "v1",
    "outputDirectory": "src/generated/v1",
    "specVersion": 3,
    "securityDefinitions": {
      "jwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "routes": {
    "routesDir": "src/generated/v1",
    "middleware": "express",
    "iocModule": "src/ioc",
    "authenticationModule": "src/modules/v1/auth/authentication"
  }
}